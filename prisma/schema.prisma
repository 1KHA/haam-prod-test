// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlite"
  url      = "file:./dev.db"
}

model User {
  id            String    @id @default(uuid())
  email         String    @unique
  password      String
  name          String
  role          UserRole
  specialization String?
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt
  profile       Profile?
  participantProfile ParticipantProfile?
  startupProfile StartupProfile?
  mentorProfile MentorProfile?
  investorProfile InvestorProfile?
  judgeProfile JudgeProfile?
  adminProfile AdminProfile?
  programManagerProfile ProgramManagerProfile?
  entrepreneurProfile EntrepreneurProfile?
  startups      Startup[] // Added relation to startups
  teamMembers   TeamMember[] // Added relation to team members
  rolePermissions RolePermission[] // Added relation to role permissions
  programs      Program[] // Added relation to programs
  managedCohorts Cohort[] // Added relation to cohorts as manager
  cohortMentorships CohortMentor[] // Added relation to cohort mentorships
  invitationsSent Invitation[] @relation("InviterToInvitation")
  companyMemberships CompanyMember[] @relation("UserToCompanyMember")
  invitationsReceived Invitation[] @relation("InviteeToInvitation") // Added for clarity, though not strictly required by error
}

model Profile {
  id            String    @id @default(uuid())
  userId        String    @unique
  user          User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  bio           String?
  avatar        String?
  phone         String?
  address       String?
  city          String?
  country       String?
  position      String?   // Added position field
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt
}

model ParticipantProfile {
  id            String    @id @default(uuid())
  userId        String    @unique
  user          User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  skills        String?
  interests     String?
  education     String?
  experience    String?
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt
}

model StartupProfile {
  id            String    @id @default(uuid())
  userId        String    @unique
  user          User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  companyName   String
  industry      String?
  stage         String?
  foundingDate  DateTime?
  website       String?
  description   String?
  teamSize      Int?
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt
}

model MentorProfile {
  id            String    @id @default(uuid())
  userId        String    @unique
  user          User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  expertise     String?
  experience    String?
  availability  String?
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt
}

model InvestorProfile {
  id            String    @id @default(uuid())
  userId        String    @unique
  user          User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  companyName   String?
  investmentFocus String?
  investmentStage String?
  investmentSize String?
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt
}

model JudgeProfile {
  id            String    @id @default(uuid())
  userId        String    @unique
  user          User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  specialty     String?
  experience    String?
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt
}

model AdminProfile {
  id            String    @id @default(uuid())
  userId        String    @unique
  user          User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  department    String?
  permissions   String?
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt
}

model ProgramManagerProfile {
  id            String    @id @default(uuid())
  userId        String    @unique
  user          User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  programs      String?
  responsibilities String?
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt
}

model EntrepreneurProfile {
  id            String    @id @default(uuid())
  userId        String    @unique
  user          User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  organizationName String
  industry      String?
  focusAreas    String?
  programLength String?
  website       String?
  description   String?
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt
}

// New model for team members
model TeamMember {
  id            String    @id @default(uuid())
  name          String
  position      String
  email         String
  phone         String
  avatar        String?
  department    String
  creatorId     String
  creator       User      @relation(fields: [creatorId], references: [id])
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt
}

// New model for startups
model Startup {
  id                  String         @id @default(uuid())
  name                String
  industry            String
  stage               String
  description         String
  problem             String
  solution            String
  targetMarket        String?
  businessModel       String?
  competitiveAdvantage String?
  teamSize            Int            @default(1)
  fundingNeeds        String?
  pitchDeckUrl        String?
  status              String         @default("PENDING") // PENDING, APPROVED, REJECTED
  creatorId           String
  creator             User           @relation(fields: [creatorId], references: [id])
  cohortMemberships   CohortMember[]
  invitations         Invitation[] @relation("StartupToInvitation")
  members             CompanyMember[] @relation("StartupToCompanyMember")
  createdAt           DateTime       @default(now())
  updatedAt           DateTime       @updatedAt
}

model Hackathon {
  id            String    @id @default(uuid())
  name          String
  description   String?
  startDate     DateTime
  endDate       DateTime
  location      String?
  status        HackathonStatus @default(UPCOMING)
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt
  teams         Team[]
  judges        Judge[]
  prizes        Prize[]
  timeline      TimelineEvent[]
}

model Team {
  id            String    @id @default(uuid())
  name          String
  hackathonId   String
  hackathon     Hackathon @relation(fields: [hackathonId], references: [id], onDelete: Cascade)
  members       Int?
  project       String?
  status        String?
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt
}

model Judge {
  id            String    @id @default(uuid())
  name          String
  hackathonId   String
  hackathon     Hackathon @relation(fields: [hackathonId], references: [id], onDelete: Cascade)
  specialty     String?
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt
}

model Prize {
  id            String    @id @default(uuid())
  rank          String
  amount        String
  hackathonId   String
  hackathon     Hackathon @relation(fields: [hackathonId], references: [id], onDelete: Cascade)
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt
}

model TimelineEvent {
  id            String    @id @default(uuid())
  date          DateTime
  event         String
  hackathonId   String
  hackathon     Hackathon @relation(fields: [hackathonId], references: [id], onDelete: Cascade)
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt
}

// New models for roles and permissions
model Role {
  id            String    @id @default(uuid())
  name          String    @unique
  description   String?
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt
  permissions   RolePermission[]
}

model Permission {
  id            String    @id @default(uuid())
  category      String    // e.g., dashboard, users, programs, etc.
  action        String    // e.g., view, edit, add, delete
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt
  roles         RolePermission[]

  @@unique([category, action])
}

model RolePermission {
  id            String    @id @default(uuid())
  roleId        String
  role          Role      @relation(fields: [roleId], references: [id], onDelete: Cascade)
  permissionId  String
  permission    Permission @relation(fields: [permissionId], references: [id], onDelete: Cascade)
  userId        String?   // Optional: for user-specific permissions
  user          User?     @relation(fields: [userId], references: [id], onDelete: Cascade)
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt

  @@unique([roleId, permissionId, userId])
}

enum UserRole {
  ADMIN
  PROGRAM_MANAGER
  MENTOR
  INVESTOR
  JUDGE
  PARTICIPANT
  ENTREPRENEUR
}

enum HackathonStatus {
  UPCOMING
  ACTIVE
  COMPLETED
  CANCELLED
}

enum InvitationType {
  ENTREPRENEUR
  COMPANY
}

enum InvitationStatus {
  PENDING
  ACCEPTED
  REJECTED
  EXPIRED
}

enum MemberStatus {
  ACTIVE
  INVITED
  REJECTED
}

// Models for programs and cohorts
model Program {
  id                  String    @id @default(uuid())
  name                String
  description         String?
  startDate           DateTime?
  endDate             DateTime?
  location            String?
  type                String    // e.g., Accelerator, Incubator, Workshop
  status              String    @default("DRAFT") // DRAFT, ACTIVE, COMPLETED, CANCELLED
  capacity            Int?
  applicationDeadline DateTime?
  requirements        String?
  benefits            String?
  creatorId           String
  creator             User      @relation(fields: [creatorId], references: [id], onDelete: Cascade)
  cohorts             Cohort[]
  createdAt           DateTime  @default(now())
  updatedAt           DateTime  @updatedAt
}

model Cohort {
  id          String         @id @default(uuid())
  name        String
  description String?
  startDate   DateTime
  endDate     DateTime
  status      String         @default("UPCOMING") // UPCOMING, ACTIVE, COMPLETED
  capacity    Int?
  programId   String
  program     Program        @relation(fields: [programId], references: [id], onDelete: Cascade)
  managerId   String
  manager     User           @relation(fields: [managerId], references: [id], onDelete: Cascade)
  members     CohortMember[]
  mentors     CohortMentor[]
  createdAt   DateTime       @default(now())
  updatedAt   DateTime       @updatedAt
}

model CohortMember {
  id        String   @id @default(uuid())
  cohortId  String
  cohort    Cohort   @relation(fields: [cohortId], references: [id], onDelete: Cascade)
  startupId String
  startup   Startup  @relation(fields: [startupId], references: [id], onDelete: Cascade)
  status    String   @default("ACTIVE") // ACTIVE, GRADUATED, DROPPED
  joinDate  DateTime @default(now())
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([cohortId, startupId])
}

model CohortMentor {
  id        String   @id @default(uuid())
  cohortId  String
  cohort    Cohort   @relation(fields: [cohortId], references: [id], onDelete: Cascade)
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  role      String?  // e.g., Lead Mentor, Technical Mentor, Business Mentor
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([cohortId, userId])
}

model Invitation {
  id           String           @id @default(uuid())
  type         InvitationType
  inviterId    String
  inviter      User             @relation("InviterToInvitation", fields: [inviterId], references: [id])
  inviteeEmail String
  invitee      User?            @relation("InviteeToInvitation", fields: [inviteeEmail], references: [email]) // Link to User model if invitee exists
  startupId    String?
  startup      Startup?         @relation("StartupToInvitation", fields: [startupId], references: [id])
  status       InvitationStatus  @default(PENDING)
  respondedAt  DateTime?
  createdAt    DateTime         @default(now())
  updatedAt    DateTime         @updatedAt
  companyMember CompanyMember? // This is the back-relation, no fields/references here
}

model CompanyMember {
  id           String      @id @default(uuid())
  startupId    String
  startup      Startup     @relation("StartupToCompanyMember", fields: [startupId], references: [id], onDelete: Cascade)
  userId       String
  user         User        @relation("UserToCompanyMember", fields: [userId], references: [id], onDelete: Cascade)
  role         String      @default("Member")
  status       MemberStatus @default(INVITED)
  invitationId String?     @unique // Ensure uniqueness for one-to-one relation
  invitation   Invitation? @relation(fields: [invitationId], references: [id])
  joinedAt     DateTime?
  createdAt    DateTime    @default(now())
  updatedAt    DateTime    @updatedAt

  @@unique([startupId, userId])
}
